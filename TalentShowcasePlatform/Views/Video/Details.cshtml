@model TalentShowcasePlatform.Models.Video

<h2>Video Details</h2>

<div>
    <strong>Title:</strong> @Model.Title
</div>
<div>
    <strong>Description:</strong> @Model.Description
</div>
<div>
    <strong>Category:</strong> @Model.Category?.Name
</div>
<div>
    <video width="500" controls>
        <source src="@Model.Url" type="video/mp4">
        Your browser does not support the video tag.
    </video>
</div>
<div>
    <strong>Public:</strong> @(Model.IsPublic ? "Yes" : "No")
</div>
<div>
    <strong>Comments Allowed:</strong> @(Model.CommentsAllowed ? "Yes" : "No")
</div>
