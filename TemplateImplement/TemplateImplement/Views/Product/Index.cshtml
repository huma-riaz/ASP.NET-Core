@{
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
@model List<Products> 
}

@if (@TempData["success"] != null)
{
        <div class="alert alert-success" role="alert" id="success">
        @TempData["success"]
    </div>

}


<div class="row">  
    <div class="col-12 col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4>All Products</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-md">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Action</th>
                        </tr>

                        <tbody>
                            @{
                                var count = 1;
                                @foreach(var item in Model)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                        <td>@item.Price</td>
                                        <td>
                                            @if(item.Stock > 0)
                                            {
                                                <div class="badge badge-success">In Stock</div>
                                            }else
                                            {
                                                <div class="badge badge-danger">Out of Stock</div>
                                            }
                                        </td>

                                        <td>
                                            <a class="btn btn-warning" asp-controller="Product" asp-action="View" asp-route-id="@item.ID">View</a>
                                            <a class="btn btn-success" asp-controller="Product" asp-action="Edit" asp-route-id="@item.ID">Edit</a>
                                            <a class="btn btn-danger" asp-controller="Product" asp-action="Delete" asp-route-id="@item.ID" onclick="return confirm('Are you sure ?')">Delete</a>

                                        </td>
                                    </tr>
                                    count++;
                                }   
                            }
                        </tbody>

                      </table>
                    </div>
                  </div>
                  <div class="card-footer text-right">
                    <nav class="d-inline-block">
                      <ul class="pagination mb-0">
                        <li class="page-item disabled">
                          <a class="page-link" href="#" tabindex="-1"><i class="fas fa-chevron-left"></i></a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1 <span
                              class="sr-only">(current)</span></a></li>
                        <li class="page-item">
                          <a class="page-link" href="#">2</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                          <a class="page-link" href="#"><i class="fas fa-chevron-right"></i></a>
                        </li>
                      </ul>
                    </nav>
                  </div>
                </div>
              </div>
        </div>


   <script>
       var div = document.getElementById('success');
       setTimeout(() => {
           div.style.display = 'none';
       },3000)
   </script>
