@model IEnumerable<TalentShowcasePlatform.Models.Group>

@{
    int sno = 1;
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-center mb-4 fw-bold" style="letter-spacing:1px;">
                💬 All Groups
            </h2>
            <div class="text-end mb-3">
            <a href="/Group/Create" class="btn btn-success px-4">
                + Create New Group
            </a>
        </div>
        </div>

        <table class="table table-striped table-hover text-center">
            <thead class="table-light">
                <tr>
                    <th style="width:80px;">S.No</th>
                    <th>Group Name</th>
                    <th style="width:150px;">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var g in Model)
                {
                        <tr>
                            <td>@sno</td>
                            <td class="fw-semibold text-center">@g.Name</td>
                            <td>
                                <a href="/Group/Details/@g.Id" class="btn btn-primary btn-sm">
                                    View
                                </a>
                            </td>
                        </tr>

                    sno++;
                }
            </tbody>
        </table>

    </div>

</div>
