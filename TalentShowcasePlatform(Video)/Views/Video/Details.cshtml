@model TalentShowcasePlatform.Models.Video

<style>
    h2.page-title {
        font-weight: 700;
        letter-spacing: 1px;
        color: #0d6efd;
        margin-bottom: 30px;
        text-align: center;
    }

    .video-card {
        max-width: 800px; /* wider card */
        margin: 0 auto;
        background: #f8f9fa;
        padding: 30px 25px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        text-align: center;
    }

    .video-card h3 {
        margin-bottom: 15px;
        font-weight: 600;
        font-size: 1.5rem;
    }

    .video-card p {
        margin-bottom: 12px;
        font-size: 1rem;
        color: #333;
    }

    .video-card video {
        width: 100%;
        max-height: 280px; /* smaller height */
        border-radius: 8px;
        margin-bottom: 20px;
        object-fit: cover;
    }

    .video-info {
        text-align: left;
        margin-bottom: 20px;
    }

    .video-info p {
        font-size: 0.95rem;
        margin-bottom: 8px;
    }

    .video-info span {
        font-weight: 600;
        color: #555;
    }

    .btn-back {
        display: inline-block;
        margin-top: 10px;
    }
</style>

<div class="container mt-4">
    <h2 class="page-title">Video Details</h2>

    <div class="video-card">
        <h3>@Model.Title</h3>
        <p>@Model.Description</p>

        <video controls>
            <source src="~/@Model.Url" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <div class="video-info">
            <p><span>Category:</span> @Model.Category?.Name</p>
            <p><span>Public:</span> @(Model.IsPublic ? "Yes" : "No")</p>
            <p><span>Allow Comments:</span> @(Model.AllowComments ? "Yes" : "No")</p>
        </div>

        <a asp-action="List" class="btn btn-secondary btn-sm btn-back">← Back to List</a>
    </div>
</div>
