@model IEnumerable<TalentShowcasePlatform.Models.Video>

<style>
    h2.page-title {
        font-weight: 700;
        letter-spacing: 1px;
        color: #0d6efd;
        margin-bottom: 20px;
        text-align: center;
    }

    table th, table td {
        vertical-align: middle;
    }

    .action-buttons form {
        display: inline;
    }
</style>

<div class="container mt-4">
    <h2 class="page-title">Videos List</h2>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Title</th>
                <th>Description</th>
                <th>Category</th>
                <th>Public</th>
                <th>Allow Comments</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                int serial = 1;
            }
            @foreach (var v in Model)
            {
                    <tr>
                        <td>@serial</td>
                        <td>@v.Title</td>
                        <td>@v.Description</td>
                        <td>@v.Category?.Name</td>
                        <td>@(v.IsPublic ? "Yes" : "No")</td>
                        <td>@(v.AllowComments ? "Yes" : "No")</td>
                        <td class="action-buttons">
                            <a asp-action="Details" asp-route-id="@v.ID" class="btn btn-primary btn-sm">Details</a>

                            <form asp-action="Delete" asp-route-id="@v.ID" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this video?');">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                serial++;
            }
        </tbody>
    </table>
</div>
